{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": { "network_config": { "type": "string" } },
  "type": "object",
  "properties": {
    "ipv6": {
      "type": "object",
      "properties": {
        "gateway": { "type": "string" },
        "cidr": { "type": "string" }
      },
      "required": [ "cidr" ],
      "additionalProperties": false
    },
    "ipv4": {
      "type": "object",
      "properties": {
        "gateway": { "type": "string" },
        "cidr": { "type": "string" }
      },
      "required": [ "cidr" ],
      "additionalProperties": false
    }
  },
  "required": [ "ipv4" ],
  "additionalProperties": false
}